rules_version = '2';

// Firestore 데이터 구조 (사용자별로 완전히 격리):
//   users/{uid}/lessons/{lessonId}         -> Lesson
//   users/{uid}/books/{bookId}             -> Book (source == 'user'인 것만 동기화; 내장 책은 동기화 대상 아님)
//   users/{uid}/bookContents/{bookId}      -> { sentences: BookSentence[] }
//   users/{uid}/readingProgress/{bookId}   -> ReadingProgress
//   users/{uid}/settings/preferences       -> 재생/음성 기본 설정
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // 콘텐츠 스튜디오 관리자 페이지(contents-admin.html) 전용 — 아래 이메일로 로그인한 사람만 읽고 쓴다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nohgyuwon@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Contents Input: 정제·태깅된 내 콘텐츠 (관리자만 읽기·쓰기)
    match /contents_input/{docId} {
      allow read, write: if isAdmin();
    }

    // Contents Output: 초고·결과물 (관리자만 읽기·쓰기)
    match /contents_output/{docId} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      // 사용자 루트 문서 자체(프로필 등)는 쓰지 않지만, 혹시 쓰더라도 본인만.
      allow read, write: if isOwner(uid);

      match /lessons/{lessonId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidLesson(request.resource.data);
      }

      match /books/{bookId} {
        allow read, delete: if isOwner(uid);
        // 내장 책(bundled)은 클라이언트가 동기화하지 않지만, 혹시 섞여 들어와도
        // 서버 쪽 규칙에서 한 번 더 막는다.
        allow create, update: if isOwner(uid)
          && isValidBook(request.resource.data)
          && request.resource.data.source == 'user';
      }

      match /bookContents/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.sentences is list;
      }

      match /readingProgress/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidReadingProgress(request.resource.data);
      }

      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSettings(request.resource.data);
      }
    }

    function isValidLesson(data) {
      return isNonEmptyString(data.id)
        && isNonEmptyString(data.title)
        && isNonEmptyString(data.topic) && data.topic.size() <= 100
        && data.level in ['N5', 'N4', 'N3', 'N2', 'N1']
        && data.createdAt is number
        && data.lines is list;
    }

    function isValidBook(data) {
      return isNonEmptyString(data.id)
        && isNonEmptyString(data.title)
        && data.source in ['bundled', 'user']
        && data.encoding in ['utf-8', 'shift_jis']
        && data.sizeBytes is number && data.sizeBytes <= 2 * 1024 * 1024
        && data.addedAt is number;
    }

    function isValidReadingProgress(data) {
      return isNonEmptyString(data.bookId)
        && data.sentenceIndex is number && data.sentenceIndex >= 0
        && data.updatedAt is number;
    }

    function isValidSettings(data) {
      return (!('speed' in data) || data.speed is number)
        && (!('gapSeconds' in data) || (data.gapSeconds is number && data.gapSeconds >= 0 && data.gapSeconds <= 5))
        && (!('speakerAVoice' in data) || data.speakerAVoice is string)
        && (!('speakerBVoice' in data) || data.speakerBVoice is string)
        && (!('bookVoice' in data) || data.bookVoice is string);
    }

    // 그 외 모든 경로는 기본 거부(명시되지 않은 컬렉션/문서는 접근 불가).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
