{
  "name": "jp-listening-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run typecheck --workspace=shared && npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test": "npm run test --workspace=shared && npm run test --workspace=server && npm run test --workspace=client",
    "lint": "eslint ."
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "typescript": "5.9.3",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@eslint/js": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0"
  }
}
