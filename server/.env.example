# Gemini (레슨 생성용)
# API Key는 더 이상 서버가 보관하지 않는다 — 각 사용자가 클라이언트 설정 화면에서
# 본인의 Gemini API Key를 입력하면 요청마다 함께 전송된다.
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Text-to-Speech
# ADC(Application Default Credentials) 인증에 쓰이는 서비스 계정 JSON 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# 서버 포트
PORT=8787
